#!/bin/sh
set -e

THEME=/usr/share/plymouth/themes/nubo/nubo.plymouth

if [ "$1" = "configure" ]; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
        default.plymouth "$THEME" 200

    # The boot screen lives in the initramfs, so it must be rebuilt to show.
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u || true
    fi

    # Console login banner. Copied rather than shipped under /etc: a packaged
    # file there is a configuration file, and replacing another package's
    # configuration file makes every install stop and ask what to do.
    install -m 0644 /usr/share/nubo/os/issue /etc/issue
    install -m 0644 /usr/share/nubo/os/issue.net /etc/issue.net
    # Other systems' installers name this one from here (dual-boot menus).
    install -m 0644 /usr/share/nubo/os/lsb-release /etc/lsb-release

    install -m 0644 /usr/share/nubo/os/legal /etc/legal
    update-alternatives --install /usr/share/plymouth/themes/text.plymouth \
        text.plymouth /usr/share/plymouth/themes/nubo-text/nubo-text.plymouth 200

    # Console message of the day: no Ubuntu news, help links or Pro adverts.
    if [ -f /etc/default/motd-news ]; then
        sed -i 's/^ENABLED=1/ENABLED=0/' /etc/default/motd-news
    fi
    for hook in 10-help-text 50-motd-news 91-contract-ua-esm-status 91-release-upgrade 95-hwe-eol; do
        [ -e "/etc/update-motd.d/$hook" ] && chmod -x "/etc/update-motd.d/$hook" || true
    done

    # Renamed app entries. /usr/local/share/applications is searched before
    # /usr/share/applications, so a link there overrides the original entry.
    mkdir -p /usr/local/share/applications
    for f in /usr/share/nubo/applications/*.desktop; do
        [ -e "$f" ] && ln -sf "$f" "/usr/local/share/applications/$(basename "$f")"
    done

    # Pick up the pinned boot loader name.
    if command -v update-grub >/dev/null 2>&1; then
        update-grub || true
    fi
fi

#DEBHELPER#
