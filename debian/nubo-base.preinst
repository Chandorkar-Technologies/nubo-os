#!/bin/sh
set -e
# Files owned by Ubuntu packages that Nubo replaces. Originals are kept
# beside them with a .ubuntu suffix and return if this package is removed.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
    for file in /etc/chrony/sources.d/ubuntu-ntp-pools.sources /etc/debuginfod/elfutils.urls /etc/update-manager/release-upgrades; do
        mkdir -p "$(dirname "$file")"
        dpkg-divert --package nubo-base --quiet --add --rename --divert "$file.ubuntu" "$file"
    done
fi
#DEBHELPER#
