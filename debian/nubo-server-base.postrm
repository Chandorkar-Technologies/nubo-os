#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    rm -f /etc/issue /etc/issue.net /etc/lsb-release
    for file in /usr/lib/os-release /etc/issue /etc/issue.net /etc/lsb-release; do
        dpkg-divert --package nubo-server-base --remove --rename "$file" || true
    done
fi
#DEBHELPER#
