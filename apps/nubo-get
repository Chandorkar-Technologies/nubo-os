#!/usr/bin/env python3
"""Download a popular app from Flathub, then open it.

Usage: nubo-get [--install-only] FLATPAK_ID [NAME]
"""

import shutil
import subprocess
import sys

FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"


def notify(kind, text):
    if shutil.which("zenity"):
        subprocess.run(["zenity", f"--{kind}", "--title=Nubo Store", f"--text={text}", "--no-wrap"])
    else:
        print(text, file=sys.stderr)


def installed(app_id):
    return subprocess.run(["flatpak", "info", app_id], capture_output=True).returncode == 0


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(2)
    args = sys.argv[1:]
    install_only = "--install-only" in args
    args = [a for a in args if a != "--install-only"]
    app_id = args[0]
    name = args[1] if len(args) > 1 else app_id

    if not installed(app_id):
        subprocess.run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB],
                       capture_output=True)
        progress = None
        if shutil.which("zenity"):
            progress = subprocess.Popen(
                ["zenity", "--progress", "--pulsate", "--no-cancel", "--auto-close",
                 "--title=Nubo Store", f"--text=Downloading {name}…"],
                stdin=subprocess.PIPE, text=True)
        result = subprocess.run(
            ["flatpak", "install", "--user", "--noninteractive", "-y", "flathub", app_id],
            capture_output=True, text=True)
        if progress:
            try:
                progress.stdin.write("100\n")
                progress.stdin.close()
            except (BrokenPipeError, OSError):
                pass  # no screen to show the progress window on
            progress.wait()
        if result.returncode != 0:
            tail = (result.stderr or result.stdout).strip().splitlines()[-1:] or ["unknown error"]
            notify("error", f"Could not download {name}.\n\nCheck your internet connection and try again.\n({tail[0]})")
            sys.exit(1)

    subprocess.run(["/usr/libexec/nubo/nubo-app-stubs"], capture_output=True)
    if install_only:
        return
    subprocess.Popen(["flatpak", "run", app_id], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
