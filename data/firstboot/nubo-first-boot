#!/bin/bash
# One-time cleanup after installation: things the Ubuntu base brings that
# Nubo OS does not use, which can only be removed on a running system.
# Runs on every boot until it has finished once (needs snapd to be up).

set -uo pipefail
MARKER=/var/lib/nubo/first-boot-done
# Belt and braces: never touch the installation media.
mountpoint -q /cdrom && exit 0
[[ -e "${MARKER}" ]] && exit 0

log() { echo "nubo-first-boot: $*"; }

# Ubuntu's store, its helpers and the Firefox snap; Firefox comes from a
# regular package on Nubo OS. Removed only when snapd is ready.
if command -v snap >/dev/null && snap wait system seed.loaded 2>/dev/null; then
  for s in snap-store firmware-updater desktop-security-center prompting-client snapd-desktop-integration hwctl firefox thunderbird; do
    if snap list "$s" >/dev/null 2>&1; then
      snap remove --purge "$s" >/dev/null 2>&1 && log "removed snap $s"
    fi
  done
else
  log "snapd not ready; trying again next boot"
  exit 1
fi

# Canonical's Pro client is not part of Nubo OS. snapd stays on the desktop for now:
# the Nubo sign-in broker (authd-oidc) is distributed as a snap.
apt-get purge -y -qq ubuntu-pro-client ubuntu-advantage-tools ubuntu-advantage-desktop-daemon >/dev/null 2>&1 \
  && apt-get autoremove -y -qq >/dev/null 2>&1 || true

# App store source: Flathub. Needs the network; harmless to retry later.
if command -v flatpak >/dev/null; then
  flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 \
    && log "Flathub added" || log "Flathub not added yet (offline?)"
fi

# Nubo Office: the Nubo repository, and the suite itself. Needs the network. Flathub (above) supplies
# the runtime it runs on. If this fails the launchers retry the install on first use, so it is harmless.
if command -v flatpak >/dev/null; then
  flatpak remote-add --if-not-exists --system nubo https://archive.nubosuite.tech/flatpak/nubo.flatpakrepo >/dev/null 2>&1 \
    && log "Nubo Flatpak repository added" || log "Nubo Flatpak repository not added yet (offline or not published)"
  if ! flatpak info tech.nubosuite.Office >/dev/null 2>&1; then
    flatpak install --system -y --noninteractive nubo tech.nubosuite.Office >/dev/null 2>&1 \
      && log "Nubo Office installed" || log "Nubo Office not installed yet (offline or not published); the launchers install it on first use"
  fi
fi

# scrcpy (Android screen mirroring) needs a helper file from its makers. It is not fetched while
# installing, so fetch it now if the computer is online. Harmless to retry on the next boot.
if [[ ! -s /usr/share/scrcpy/scrcpy-server && -x /usr/libexec/scrcpy-update-server ]]; then
  /usr/libexec/scrcpy-update-server >/dev/null 2>&1 \
    && log "scrcpy helper fetched" || log "scrcpy helper not fetched yet (offline?)"
fi

# Login-screen picture for the account(s) made by the installer.
if [[ -f /usr/share/nubo/avatar.png ]]; then
  while IFS=: read -r user _ uid _ _ home _; do
    [[ "${uid}" -ge 1000 && "${uid}" -lt 60000 && -d "${home}" ]] || continue
    [[ -e "${home}/.face" ]] && continue
    cp /usr/share/nubo/avatar.png "${home}/.face" && chown "${user}:" "${home}/.face"
    mkdir -p /var/lib/AccountsService/users
    printf '[User]\nIcon=%s/.face\n' "${home}" >"/var/lib/AccountsService/users/${user}"
  done </etc/passwd
fi

# Notebook app (Folio) is not part of Nubo OS: Reminders and Text Editor cover it.
flatpak uninstall --system --noninteractive com.toolstack.Folio >/dev/null 2>&1 || true

# LibreOffice is replaced by Collabora Office (below).
apt-get purge -y -qq 'libreoffice*' >/dev/null 2>&1 && apt-get autoremove -y -qq >/dev/null 2>&1 || true

# Apps that come from Flathub. Needs the network; retried next boot until done.
FLATPAKS="org.mozilla.firefox org.localsend.localsend_app io.github.qwersyk.Newelle com.collaboraoffice.Office de.haeckerfelix.Shortwave com.spotify.Client org.videolan.VLC"
# One app at a time: an app that does not exist for this CPU (Spotify is
# x86-only) is skipped instead of blocking the others. Only a network failure
# makes us retry on the next boot.
retry=0
for app in ${FLATPAKS}; do
  flatpak info --system "${app}" >/dev/null 2>&1 && continue
  if ! flatpak remote-info --system flathub "${app}" >/dev/null 2>&1; then
    if flatpak remote-ls --system flathub >/dev/null 2>&1; then
      log "${app}: not available for this CPU, skipped"
    else
      retry=1
    fi
    continue
  fi
  if flatpak install --system --noninteractive --or-update flathub "${app}" >/dev/null 2>&1; then
    log "installed: ${app}"
  else
    retry=1
  fi
done
if [[ "${retry}" -eq 1 ]]; then
  log "some Flathub apps not installed yet (offline?); trying again next boot"
  exit 1
fi

mkdir -p "$(dirname "${MARKER}")"
date -u +%FT%TZ >"${MARKER}"
log "done"
